rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Fields changed by this update
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function ownsEnrollment(enrollmentId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.studentId == request.auth.uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Students can never grant themselves a role; admins are promoted by an admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      allow update: if isAdmin() ||
                       (isOwner(userId) && !changed().hasAny(['role', 'uid', 'email', 'createdAt']));
      allow delete: if isAdmin();
    }

    // ── Courses ────────────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true; // public catalogue
      allow create, delete: if isAdmin();
      // Students may only bump the enrollment counter by exactly one
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        changed().hasOnly(['enrolledStudents']) &&
                        request.resource.data.enrolledStudents == resource.data.get('enrolledStudents', 0) + 1);
    }

    match /courseFiles/{fileId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Enrollments ────────────────────────────────────────────────────────
    // Completion, exam and certificate fields are written only by the
    // final-exam Netlify Function (Admin SDK bypasses these rules).
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() &&
                     (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status == 'active' &&
                       !request.resource.data.keys().hasAny(['certificateId', 'examScore', 'examAttempts', 'completedAt']);
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.studentId == request.auth.uid &&
                        changed().hasOnly(['completedLessons', 'progress', 'currentModule', 'completedModules',
                                           'quizResults', 'lastPosition', 'lastAccessedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /curriculums/{enrollmentId} {
      allow read, write: if ownsEnrollment(enrollmentId) || isAdmin();
    }

    // ── Learning activity ──────────────────────────────────────────────────
    match /quizResults/{resultId} {
      allow read: if isSignedIn() &&
                     (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
    }

    match /exams/{examId} {
      allow read: if isSignedIn() &&
                     (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if false; // server only
    }

    match /certificates/{certificateId} {
      // Anyone with the certificate link can verify it; listing is restricted.
      allow get: if true;
      allow list: if isSignedIn() &&
                     (resource.data.studentId == request.auth.uid || isAdmin());
      allow write: if false; // issued by the final-exam function only
    }

    match /gamification/{gamificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    // ── Personal study tools ───────────────────────────────────────────────
    match /notes/{noteId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    match /todos/{todoId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    // Virtual Buddy messages
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       ownsEnrollment(request.resource.data.enrollmentId);
    }
  }
}
